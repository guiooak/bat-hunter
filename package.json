{
  "name": "bat-hunter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write ./src",
    "typecheck": "tsc -b",
    "format:check": "prettier --check ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only database --project demo-bat-hunter 'vitest run -c vitest.rules.config.ts'"
  },
  "dependencies": {
    "@fontsource/barlow": "5",
    "@fontsource/chakra-petch": "5",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "uuid": "^12.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@fontsource/jetbrains-mono": "5",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "sass-embedded": "^1.106.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
